extends: default

rules:
  anchors: disable
  braces:
    max-spaces-inside: 1
  comments:
    level: error
    min-spaces-from-content: 1
  comments-indentation:
    level: error
  document-end:
    present: false
  document-start:
    level: error
    present: false
  empty-lines:
    max: 1
    max-end: 1
  indentation:
    spaces: 2
  line-length: disable
  truthy:
    level: error
    check-keys: false
